# ─────────────────────────────────────────────────────────────
#  FaceChain — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# 1. Serper.dev — Google Lens reverse image search
#    Sign up free at: https://serper.dev  (2,500 free searches on signup)
SERPER_API_KEY=your_serper_api_key_here

# 2. imgbb — Free image hosting (needed to get a public URL for Serper)
#    Get free API key at: https://api.imgbb.com
IMGBB_API_KEY=your_imgbb_api_key_here

# 3. Infura / Alchemy — Sepolia RPC endpoint (free tier is sufficient)
#    Infura:  https://app.infura.io  → create project → copy Sepolia endpoint
#    Alchemy: https://dashboard.alchemy.com  (alternative)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# 4. Your Ethereum wallet private key
#    Use MetaMask → Account Details → Export Private Key
#    NEVER share or commit this value
PRIVATE_KEY=your_wallet_private_key_here

# 5. Your wallet's public address (0x...)
WALLET_ADDRESS=0xYourWalletAddressHere

# 6. Contract address — filled in AFTER running:  python scripts/deploy_contract.py
CONTRACT_ADDRESS=0xDeployedContractAddressHere
